--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Dialogos_en
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: cd660ffb914eeb4468e060acd7bc2fcd, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 44910403739648
    m_Localized: "Alright, well, as the temporary caretaker, I\u2019m going to need
      you to do me a small favor, okay?"
    m_Metadata:
      m_Items: []
  - m_Id: 38161433059328
    m_Localized: "Hi Mark, Frany told me that now the caretaker is on sick leave,
      you\u2019ve had to take charge, right?"
    m_Metadata:
      m_Items: []
  - m_Id: 45199265456128
    m_Localized: "So, I need you to go to classroom 3A. I\u2019m not sure what the
      issue is, but the internet isn\u2019t working, and I have an exam today with
      the first-year higher vocational students."
    m_Metadata:
      m_Items: []
  - m_Id: 45317104427008
    m_Localized: "Yeah, yeah\u2026 well, if you want, I can give you a couple of
      tissues to cry, but I need you, as the temporary caretaker, to do your job
      and help me out with something."
    m_Metadata:
      m_Items: []
  - m_Id: 45678657626112
    m_Localized: "Thanks a lot, mate \u2014 now I\u2019ll be able to fail them all."
    m_Metadata:
      m_Items: []
  - m_Id: 46004366303232
    m_Localized: No.
    m_Metadata:
      m_Items: []
  - m_Id: 49934068441088
    m_Localized: Yeah, I suppose so.
    m_Metadata:
      m_Items: []
  - m_Id: 50326315556864
    m_Localized: "Like hell I am! I\u2019m still not buying any of this"
    m_Metadata:
      m_Items: []
  - m_Id: 51475819094016
    m_Localized: Lay it on me
    m_Metadata:
      m_Items: []
  - m_Id: 51721001328640
    m_Localized: "It\u2019s not like I have a choice, so just tell me"
    m_Metadata:
      m_Items: []
  - m_Id: 52462755602432
    m_Localized: "Did you even hear me when I said I\u2019m not okay with this?"
    m_Metadata:
      m_Items: []
  - m_Id: 52486948347904
    m_Localized: What can I say? I'm all ears
    m_Metadata:
      m_Items: []
  - m_Id: 53312722919424
    m_Localized: Couldn't you just push the exam back
    m_Metadata:
      m_Items: []
  - m_Id: 53355840364544
    m_Localized: "(Sighs) Fine. I\u2019m on my way."
    m_Metadata:
      m_Items: []
  - m_Id: 54355133292544
    m_Localized: Leave
    m_Metadata:
      m_Items: []
  - m_Id: 54889512787968
    m_Localized: No sweat, man
    m_Metadata:
      m_Items: []
  - m_Id: 719593084116992
    m_Localized: Eyyy Mark. crees que podrias ayudar a tu gran amigo Joaquin?(INGLES)
    m_Metadata:
      m_Items: []
  - m_Id: 765867128872960
    m_Localized: Ahora mismo no colega(INGLES)
    m_Metadata:
      m_Items: []
  - m_Id: 766301121896448
    m_Localized: INGLES
    m_Metadata:
      m_Items: []
